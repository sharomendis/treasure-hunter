# Copy this file to .env and fill it in.
PORT=3000
FIREBASE_PROJECT_ID=treasure-hunter-cbd8f

# Firebase console > Project settings > Service accounts > Generate new private key.
# Save the file as server/serviceAccountKey.json (it is git-ignored) — NEVER commit it.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Or, on a cloud host, paste the whole JSON on one line instead:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,https://treasure-hunter-cbd8f.web.app,https://treasure-hunter-cbd8f.firebaseapp.com
